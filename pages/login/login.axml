<view class="page-login">
  <!-- 顶部品牌区域 -->
  <view class="brand-section">
    <view class="brand-icon">
      <image class="brand-icon-img" src="/assets/images/logo.png" mode="aspectFill" />
    </view>
    <text class="brand-name">丰享汇</text>
    <text class="brand-slogan">开启您的品质车生活</text>
  </view>

  <!-- 授权区域 -->
  <view class="auth-section">
    <!-- 加载中 -->
    <block a:if="{{loading}}">
      <view class="loading-view">
        <view class="loading-spinner" />
        <text class="loading-text">正在获取授权...</text>
      </view>
    </block>

    <!-- 授权失败 -->
    <block a:elif="{{authError}}">
      <view class="error-view">
        <image class="error-icon" src="https://via.placeholder.com/80x80/FFF0F0/FF4D4F?text=!" mode="aspectFill" />
        <text class="error-text">{{authError}}</text>
        <button class="primary-btn" onTap="onRetry">重新授权</button>
      </view>
    </block>

    <!-- 已获取 userId，授权手机号 -->
    <block a:elif="{{userId}}">
      <view class="phone-section">
        <!-- <text class="phone-title">授权手机号</text> -->
        <button
          class="primary-btn phone-btn"
          open-type="getAuthorize"
          scope="phoneNumber"
          onGetAuthorize="getPhoneNumber"
          onError="handleAuthError"
          disabled="{{phoneLoading}}"
        >
          {{phoneLoading ? '处理中...' : '本机号码一键登录'}}
        </button>
        <text class="phone-note">我们将严格保护您的个人信息</text>
      </view>
    </block>
  </view>

  <!-- 底部版权 -->
  <view class="footer">
    <text class="footer-text">登录即表示同意《用户协议》和《隐私政策》</text>
  </view>
</view>
