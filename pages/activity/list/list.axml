<view class="page-activity-list">
  <view class="activity-item" a:for="{{activities}}" a:for-item="item" data-code="{{item.code}}" onTap="onActivityTap">
    <image class="activity-img" src="{{item.displayImage}}" mode="aspectFill" />
    <view class="activity-info">
      <view class="activity-name">{{item.name || item.title}}</view>
      <view class="activity-time" a:if="{{item.createTime}}">{{item.createTime}}</view>
    </view>
  </view>

  <view class="empty-state" a:if="{{activities.length === 0 && !loading}}">
    <text>暂无活动</text>
  </view>

  <view class="loading-state" a:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
