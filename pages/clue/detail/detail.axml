<view class="page-clue-detail">
  <scroll-view scroll-y class="scroll-area">
    <!-- 活动信息 -->
    <view class="section-card">
      <view class="section-title">活动信息</view>
      <view class="info-row">
        <text class="info-label">活动名称：</text>
        <text>{{clue.activityName || clue.jobName || '-'}}</text>
      </view>
    </view>

    <!-- 预约信息 -->
    <view class="section-card">
      <view class="section-title">预约信息</view>
      <view class="info-row">
        <text class="info-label">姓名：</text>
        <text>{{clue.name}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">手机号：</text>
        <text>{{clue.tel}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">提交时间：</text>
        <text>{{clue.createTime}}</text>
      </view>
      <view class="info-row" a:for="{{leadInfoList}}" a:for-item="field" a:for-index="idx">
        <text class="info-label">{{field.label}}：</text>
        <text>{{field.value}}</text>
      </view>
    </view>

    <!-- 协议文件（仅开启协议的的活动展示） -->
    <view class="section-card" a:if="{{clue.protocolUploadEnabled}}">
      <view class="section-title">协议文件</view>
      <view class="file-row" a:if="{{clue.agreementUrl}}" onTap="onPreviewFile" data-url="{{clue.agreementUrl}}">
        <text class="file-icon">📄</text>
        <text class="file-name">上传协议</text>
        <text class="file-arrow">›</text>
      </view>
      <view class="no-file" a:if="{{!clue.agreementUrl}}">
        <text>暂无协议文件</text>
      </view>
    </view>

    <!-- 审核状态 -->
    <view class="section-card">
      <view class="section-title">审核状态</view>
      <view class="status-row">
        <view class="status-badge-lg {{reviewStatusClass}}">
          {{reviewStatusText}}
        </view>
      </view>
      <view class="review-remark" a:if="{{clue.reviewRemark}}">
        <text class="remark-label">驳回原因：</text>
        <text>{{clue.reviewRemark}}</text>
      </view>
    </view>

    <view style="height: 200rpx"></view>
  </scroll-view>

  <!-- 底部操作 -->
  <view class="bottom-actions" a:if="{{clue._id}}">
    <!-- 协议上传：仅开启协议上传的活动才显示 -->
    <button
      class="action-btn btn-secondary"
      a:if="{{clue.protocolUploadEnabled && clue.reviewStatus === 'rejected'}}"
      onTap="onReUploadAgreement"
    >
      重新上传协议
    </button>

    <button
      class="action-btn btn-secondary"
      a:if="{{clue.protocolUploadEnabled && !clue.agreementUrl && clue.reviewStatus === 'pending'}}"
      onTap="onReUploadAgreement"
    >
      上传协议
    </button>

    <!-- 已上传，等待审核 -->
    <view
      class="claimed-text"
      a:if="{{clue.protocolUploadEnabled && clue.agreementUrl && clue.reviewStatus === 'pending'}}"
    >
      等待审核
    </view>

    <button
      class="action-btn btn-primary"
      a:if="{{clue.benefitEnabled && clue.reviewStatus === 'approved' && clue.benefitClaimStatus === 'unclaimed'}}"
      onTap="onClaimBenefit"
    >
      领取权益
    </button>

    <view
      class="claimed-text"
      a:if="{{clue.benefitEnabled && clue.benefitClaimStatus === 'claimed'}}"
    >
      已领取权益
    </view>
  </view>
</view>
