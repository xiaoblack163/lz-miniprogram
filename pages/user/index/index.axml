<view class="page-user">
  <!-- 用户资料头部 -->
  <view class="profile-header">
    <view class="header-bg" />
    <view class="profile-content">
      <block a:if="{{isLogin}}">
        <view class="avatar-wrap" onTap="onAvatarTap">
          <image
            class="avatar"
            src="{{userInfo.avatar || '/assets/images/avatar.png'}}"
            mode="aspectFill"
          />
        </view>
        <view class="user-info">
          <text class="nickname">{{userInfo.nickName || '支付宝用户'}}</text>
          <text class="user-desc">欢迎回来</text>
        </view>
      </block>
      <block a:else>
        <view class="avatar-wrap" onTap="onAvatarTap">
          <image
            class="avatar"
            src="/assets/images/avatar.png"
            mode="aspectFill"
          />
        </view>
        <view class="user-info" onTap="onAvatarTap">
          <text class="nickname login-hint">点击登录</text>
          <text class="user-desc">登录后享受更多服务</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-card">
    <view class="menu-item" onTap="onMyClues">
      <view class="menu-icon-bg menu-icon-clue">
        <text class="menu-icon-text">📋</text>
      </view>
      <view class="menu-body">
        <text class="menu-label">我的预约</text>
        <text class="menu-desc">查看试驾预约记录</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section" a:if="{{isLogin}}">
    <button class="logout-btn" onTap="onLogout">退出登录</button>
  </view>

  <!-- 返回首页 -->
  

  <!-- 底部 -->
  <view class="footer">
    <image class="footer-logo" src="https://via.placeholder.com/60x60/1677FF/FFFFFF?text=丰" mode="aspectFill" />
    <text class="footer-name">丰享汇</text>
    <text class="version">v1.0.0</text>
  </view>
</view>
